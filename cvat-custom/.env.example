# =============================================================================
# CVAT 平台集成环境变量示例
#
# 用法：复制为仓库根目录的 .env（docker compose 会自动读取），或 export 后再启动。
#   cp cvat-custom/.env.example .env
#   docker compose -f docker-compose.yml -f docker-compose.override.yml \
#                  -f cvat-custom/docker-compose.platform.yml \
#                  -f cvat-custom/ldap/docker-compose.lldap.yml up -d
# （不需要 LLDAP 时可省略最后一个 -f。显式 -f 后 docker-compose.override.yml
#   不再自动加载，所以必须全部显式列出。）
#
# ⚠️ 本文件只放占位值，不要写入任何真实密钥/口令。私钥文件请放在
#    cvat-custom/keys/ 下（该目录的 .gitignore 已忽略 *.pem，绝不入库）。
# =============================================================================

# ---- 平台与 CVAT 来源（origin）------------------------------------------------
# 平台（iframe 宿主）页面的来源。会写入 CSP frame-ancestors、CSRF/CORS 白名单，
# 并作为 SSO token 的默认签发者（iss）。
PLATFORM_ORIGIN=http://localhost:5173

# CVAT 自身的对外来源。会加入 CSRF 信任列表，供跨域请求使用。
CVAT_ORIGIN=http://localhost:7000

# ---- Cookie -------------------------------------------------------------------
# Cookie 生效的域名。跨子域共享登录态时填写（例如 .example.com）；留空表示
# 仅当前 host 生效。
COOKIE_DOMAIN=

# Cookie 是否只在 HTTPS 下发送。生产（HTTPS）设为 true；本地 HTTP 验证保持 false。
COOKIE_SECURE=false

# ---- LLDAP（可选）-------------------------------------------------------------
# 留空则 CVAT 保持 BASIC 认证（本地验证 SSO 时不需要 LLDAP）。
# 设置后 settings.py 会启用 django_auth_ldap 后端，用户名/密码走 LLDAP。
# 在容器网络内固定为 ldap://lldap:3890。
LLDAP_URI=

# LLDAP 的基础 DN。
LLDAP_BASE_DN=dc=drone-platform,dc=com

# LLDAP 绑定账号 DN；留空时默认 uid=svc-bind,ou=people,<LLDAP_BASE_DN>。
# 注意：绑定账号是只读的 svc-bind（lldap_strict_readonly 组），不是 admin。
LLDAP_BIND_DN=

# svc-bind 绑定账号口令（仅当 LLDAP_URI 非空时 CVAT 需要；由 init-lldap.sh 生成）。
LLDAP_BIND_PASSWORD=

# ---- LLDAP 服务自身（仅部署/初始化 LLDAP 时需要，CVAT 容器不读这些变量）---------
# 以下三个口令/密钥由 cvat-custom/scripts/init-lldap.sh 在首次运行时自动生成强随机值
# 并写入 .env；不需要手工填写，也绝不提交到 git。

# LLDAP admin 账号口令（Web UI / GraphQL 管理用）。
LLDAP_ADMIN_PASSWORD=

# LLDAP Web 会话 JWT 签名密钥（强随机）。
LLDAP_JWT_SECRET=

# svc-smcb 平台服务账号口令（SMCB 后端用它走 LDAP 登录 CVAT；由 init-lldap.sh 生成）。
LLDAP_SVC_SMCB_PASSWORD=

# LLDAP 镜像版本（固定版本，避免漂移）。
LLDAP_VERSION=v0.6.3

# LLDAP 端口（只绑 127.0.0.1）。
LLDAP_LDAP_PORT=3890
LLDAP_HTTP_PORT=17170

# ---- CVAT 基础编排 ------------------------------------------------------------
# 访问 CVAT 时使用的域名，基础 docker-compose.yml 的 traefik 规则会用到。
CVAT_HOST=localhost
