FROM node:lts-slim AS cvat-ui

ENV TERM=xterm \
    LANG='C.UTF-8'  \
    LC_ALL='C.UTF-8'

# Install dependencies
RUN npm install -g corepack
COPY .yarnrc.yml /tmp/
COPY package.json /tmp/
COPY yarn.lock /tmp/
COPY cvat-core/package.json /tmp/cvat-core/
COPY cvat-canvas/package.json /tmp/cvat-canvas/
COPY cvat-canvas3d/package.json /tmp/cvat-canvas3d/
COPY cvat-ui/package.json /tmp/cvat-ui/
COPY cvat-data/package.json /tmp/cvat-data/

# Install common dependencies
WORKDIR /tmp/
RUN DISABLE_HUSKY=1 yarn install --immutable

# react-color 2.19.3 的 Saturation 组件在卸载时可能沿着 window.parent 查找容器，
# 在跨域 iframe 中访问 parent.document 会抛 SecurityError。
# 限制它只在当前 window 内查找，避免嵌入模式下的控制台报错。
RUN node -e "const fs=require('fs'),path=require('path'); const root='/tmp/node_modules/react-color'; const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):[path.join(d,e.name)]); let n=0; if(fs.existsSync(root)){ for(const f of walk(root)){ if(!/\\.(js|mjs)$/.test(f)) continue; const s=fs.readFileSync(f,'utf8'); const t=s.replace(/while \\(!renderWindow\\.document\\.contains\\(container\\)/g,'while (renderWindow !== window && !renderWindow.document.contains(container)'); if(t!==s){fs.writeFileSync(f,t); n++;} } } console.log('patched react-color files:', n);"

# Build source code
COPY cvat-data/ /tmp/cvat-data/
COPY cvat-core/ /tmp/cvat-core/
COPY cvat-canvas3d/ /tmp/cvat-canvas3d/
COPY cvat-canvas/ /tmp/cvat-canvas/
COPY cvat-ui/ /tmp/cvat-ui/

ARG CLIENT_PLUGINS
ARG SOURCE_MAPS_ENABLED=false

RUN CLIENT_PLUGINS="${CLIENT_PLUGINS}" \
SOURCE_MAPS_ENABLED="${SOURCE_MAPS_ENABLED}" yarn run build:cvat-ui

FROM nginxinc/nginx-unprivileged:1.31.6-alpine3.24-slim

# Replace default.conf configuration to remove unnecessary rules
COPY cvat-ui/react_nginx.conf /etc/nginx/conf.d/default.conf
COPY cvat-ui/robots.txt /usr/share/nginx/html/
COPY --from=cvat-ui /tmp/cvat-ui/dist /usr/share/nginx/html/
